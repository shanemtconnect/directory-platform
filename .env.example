# --- Required at build (next.config.ts validateEnv phase "build") ---
NEXT_PUBLIC_SITE_URL=
# Optional at build, but inlined at BUILD time: a client component can only read
# NEXT_PUBLIC_ vars, so these must be present when the image is built or the map
# and media URLs ship disabled however the container is later configured.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MEDIA_URL=

# --- Required at runtime (instrumentation.ts / worker exit 1 without these) ---
DATABASE_URL=
REDIS_URL=

# --- Wired now, checked when their feature is on ---
# Better Auth (login, account, admin)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Cloudflare Turnstile. In production a missing secret FAILS CLOSED (every form
# submission is rejected); in development it is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Later phases (listed in config/validate.ts RUNTIME_ENV_PHASE5) ---
# Media (Phase 4/5)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_CLAIM_DOCS=
# Payments. Stripe is region-blocked for Jersey; PayPal is the decided provider.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Map tiles (server side)
MAPTILER_KEY=

# --- Optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEOCODING_API_KEY=
SENTRY_DSN=
# true ONLY in the worker container. Setting it on the web service skips static
# asset retention (see docker-entrypoint.sh).
WORKER_ENABLED=
# Persistent volume that keeps every build's /_next/static across deploys.
STATIC_ASSETS_DIR=
# Staging: set to "staging" to force noindex on everything. Anything else = production.
SITE_ENV=
# Load the demo blog posts under content/blog/demo (tests and local previews only).
NEXT_PUBLIC_DEMO_MODE=
