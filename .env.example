# --- Required at build ---
NEXT_PUBLIC_SITE_URL=

# --- Required at runtime (validateEnv fails the boot without these) ---
DATABASE_URL=
REDIS_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_CLAIM_DOCS=
NEXT_PUBLIC_MEDIA_URL=

# Payments. Stripe is region-blocked for Jersey; PayPal is the decided provider.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MAPTILER_KEY=

# --- Optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEOCODING_API_KEY=
SENTRY_DSN=
# true only in the worker container
WORKER_ENABLED=

# Staging: set to "staging" to force noindex on everything. Anything else = production.
SITE_ENV=
